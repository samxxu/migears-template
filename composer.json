{
    "name": "migears/template",
    "description": "Minimalist PHP template engine — native PHP, auto-escaping, layout inheritance",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Template\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Template\\Tests\\": "tests/"
        }
    }
}
